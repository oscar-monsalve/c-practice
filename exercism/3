#include <stdio.h>
#include <math.h>

int square_of_sum(int n) {
    int acc = 0;
    for (int i = 0; i <= n; i++) {
        acc += i;
    }
    return pow(acc, 2);
}

int sum_of_squares(int n) {
    int acc = 0;
    for (int i = 0; i <= n; i++) {
        acc += sqrt(i);
    }
    return acc;
}


int main() {
    printf("%d\n", square_of_sum(10));
    printf("%d\n", sum_of_squares(10));

    return 0;
}
